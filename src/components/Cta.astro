---
import Lines from '@vibebrains/site-kit/components/Lines.astro'
import DownloadButtons from './DownloadButtons.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { brandIcons } from '@vibebrains/site-kit/brands'
import { links } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<section class="section cta">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="container cta-box" data-reveal>
    <img class="cta-mark" src={brandIcons.vibeidea} alt="" width="72" height="72" />
    <h2 class="section-title">{t('cta.title')}</h2>
    <p class="section-lead"><Lines text={t('cta.lead')} /></p>
    <DownloadButtons lang={lang} />
    <a class="source" href={links.github} rel="noopener">{t('cta.source')}</a>
  </div>
</section>

<style>
  .cta {
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(closest-side at 35% 50%, rgb(0 229 255 / 0.14), transparent 70%),
      radial-gradient(closest-side at 65% 50%, rgb(157 92 255 / 0.2), transparent 70%);
    pointer-events: none;
  }

  .cta-box {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 20px;
    text-align: center;
  }

  .cta-box :global(.downloads) {
    justify-content: center;
  }

  .section-lead {
    display: grid;
    gap: 4px;
  }

  .cta-mark {
    border-radius: 16px;
    filter: drop-shadow(0 0 30px var(--brand-glow)) drop-shadow(0 0 30px var(--spark-glow));
  }

  .source {
    font-weight: 500;
  }
</style>
