---
import type { Lang } from '../config/languages'
import { useTranslations, type Key } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)

type Motif = 'telegram' | 'watch' | 'council' | 'server' | 'journal' | 'themes'

const cards: readonly { title: Key; text: Key; motif: Motif }[] = [
  { title: 'features.telegram.title', text: 'features.telegram.text', motif: 'telegram' },
  { title: 'features.watch.title', text: 'features.watch.text', motif: 'watch' },
  { title: 'features.council.title', text: 'features.council.text', motif: 'council' },
  { title: 'features.server.title', text: 'features.server.text', motif: 'server' },
  { title: 'features.journal.title', text: 'features.journal.text', motif: 'journal' },
  { title: 'features.themes.title', text: 'features.themes.text', motif: 'themes' },
]

// Icons are stroke drawings in a 24-unit box
const ICONS: Record<Motif, string> = {
  telegram: 'M21 4 3 11l6 2 2 6 3-4 5 4ZM9 13l9-6',
  watch: 'M3 6h14v12H3ZM17 10l4-2v8l-4-2',
  council: 'M5 8a3 3 0 1 0 0 .1M19 8a3 3 0 1 0 0 .1M12 5a3 3 0 1 0 0 .1M2 19c1-3 5-3 6 0M16 19c1-3 5-3 6 0M9 16c1-3 5-3 6 0',
  server: 'M4 4h16v6H4ZM4 14h16v6H4ZM8 7h.01M8 17h.01',
  journal: 'M6 3h11v18H6ZM9 7h5M9 11h5M9 15h3',
  themes: 'M12 3a9 9 0 1 0 9 9c0-1-1-2-2-2h-3a2 2 0 0 1-2-2V5c0-1-1-2-2-2ZM7 12h.01M9 8h.01',
}
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{t('features.eyebrow')}</p>
      <h2 class="section-title" data-reveal style="--reveal-i: 1">{t('features.title')}</h2>
    </div>
    <div class="grid">
      {
        cards.map((card, i) => (
          <article class="card" data-reveal style={`--reveal-i: ${i % 3}`}>
            <div class="card-inner" data-tilt-card>
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path d={ICONS[card.motif]} />
                </svg>
              </span>
              <h3>{t(card.title)}</h3>
              <p>{t(card.text)}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1px;
    border: 1px solid var(--surface-3);
    border-radius: var(--radius-lg);
    background: var(--surface-3);
    overflow: hidden;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    perspective: 900px;
    background: var(--surface);
  }

  .card-inner {
    --tx: 0deg;
    --ty: 0deg;
    display: grid;
    align-content: start;
    gap: 10px;
    height: 100%;
    padding: 24px;
    transform: rotateX(var(--tx)) rotateY(var(--ty));
    transform-style: preserve-3d;
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.3s;
  }

  .card-inner:hover {
    background: var(--surface-2);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(0 229 255 / 0.35);
    border-radius: var(--radius);
    transform: translateZ(26px);
  }

  .icon path {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    font-size: 17px;
    transform: translateZ(18px);
  }

  p {
    color: var(--fg-muted);
    font-size: 15px;
    transform: translateZ(8px);
  }
</style>
